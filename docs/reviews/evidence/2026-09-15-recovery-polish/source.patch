+        assert_eq!(ex.pending_len(),1); assert!(e.pending_after_save.is_none()); assert!(!crate::quit::in_progress(&e));
+        merge(&mut e,&ex); assert_eq!(std::fs::read_to_string(target).unwrap(),"disk"); assert!(!e.quit);
