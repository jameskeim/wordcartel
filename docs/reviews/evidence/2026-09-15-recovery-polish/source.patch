+    let stem = path.as_ref().and_then(|p| p.file_stem()).and_then(|s| s.to_str())
+        .filter(|s| !s.is_empty() && !s.chars().any(char::is_control));
+    Some(stem.map(|s| format!("{s}-recovered.md"))
+        .unwrap_or_else(|| "recovered-untitled.md".into()))
