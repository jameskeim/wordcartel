+        assert!(ex.jobs.borrow().is_empty());
+        assert_eq!(std::fs::read_to_string(a).unwrap(), "edited A");
+        assert_eq!(std::fs::read_to_string(b).unwrap(), "edited B");
+        assert_eq!(std::fs::read_to_string(c).unwrap(), "edited C");
+    }
